PORT=3333
# front end address, used to check where requests come from
APP_URL=http://localhost:5173

# Leave it commented out to use PGlite (nothing to install).
# With the project's docker compose:
# DATABASE_URL=postgres://store:store@localhost:5432/store

# Without SMTP_URL the emails are kept in memory and shown in the store's demo inbox.
# Any SMTP works, e.g. smtps://user:password@smtp.example.com:465
# SMTP_URL=
# MAIL_FROM=Online Store <no-reply@example.com>
